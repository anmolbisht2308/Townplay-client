# Townplay web environment. Copy to apps/web/.env.local and fill in real values.
# Never commit .env.local (it is gitignored). On Vercel set these in Project → Settings → Environment Variables.
# Razorpay and web-push keys are NOT needed here: the web app gets them from the api.

# Where Next forwards /v1/* (the api). Local: http://localhost:4000 · Prod: your Render api URL.
# Required on Vercel. Rewrites are fixed at build time, so rebuild after changing it.
API_URL=http://localhost:4000

# Public origin of this site (sitemap, share links, OpenGraph). Prod: https://<your-site>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry DSN for browser error tracking (optional).
NEXT_PUBLIC_SENTRY_DSN=
